            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/data/unknown", "host": ["{{base_url}}"], "path": ["api","v1","data","unknown"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('unknown department 404', function () { pm.response.to.have.status(404); });"
          ]}}]
        },
        {
          "name": "GET /data/me without token (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/data/me", "host": ["{{base_url}}"], "path": ["api","v1","data","me"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('unauthorized', function () { pm.response.to.have.status(401); });"
          ]}}]
        }
      ]
    },
    {
      "name": "Internal Ingest (called by Windmill)",
      "item": [
        {
          "name": "POST /internal/ingest with valid token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Ingest-Token", "value": "{{ingest_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"upload_id\": 1,\n  \"rows\": [\n    {\n      \"department\": \"finance\",\n      \"source_row_id\": 9999,\n      \"employee_name\": \"Postman Test\",\n      \"amount\": 12345.67,\n      \"record_date\": \"2026-05-13\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/internal/ingest", "host": ["{{base_url}}"], "path": ["api","v1","internal","ingest"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('ingest succeeds', function () { pm.response.to.have.status(200); });",
            "pm.test('inserted finance:1', function () { pm.expect(pm.response.json().inserted.finance).to.eql(1); });"
          ]}}]
        },
        {
          "name": "POST /internal/ingest without token (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"upload_id\": 1,\n  \"rows\": []\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/internal/ingest", "host": ["{{base_url}}"], "path": ["api","v1","internal","ingest"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('unauthorized without token', function () { pm.response.to.have.status(401); });"
          ]}}]
        },
        {
          "name": "POST /internal/ingest with bad token (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Ingest-Token", "value": "wrong-token" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"upload_id\": 1,\n  \"rows\": []\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/internal/ingest", "host": ["{{base_url}}"], "path": ["api","v1","internal","ingest"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('unauthorized with bad token', function () { pm.response.to.have.status(401); });"
          ]}}]
        }
      ]
    },
