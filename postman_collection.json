{
  "info": {
    "_postman_id": "7f2a13c7-ff97-4e89-9f45-fastapi-windmill-rbac",
    "name": "FastAPI Windmill RBAC Local",
    "description": "Local test collection for FastAPI 4-role RBAC (admin/finance/hr/sales), Windmill-driven CSV pipeline, and department-scoped data access.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",        "value": "http://localhost:8000" },
    { "key": "windmill_url",    "value": "http://localhost:8080" },
    { "key": "upload_file_path","value": "sample.csv" },
    { "key": "admin_user",      "value": "admin" },
    { "key": "admin_pass",      "value": "admin1234" },
    { "key": "finance_user",    "value": "finance_user" },
    { "key": "finance_pass",    "value": "finance1234" },
    { "key": "hr_user",         "value": "hr_user" },
    { "key": "hr_pass",         "value": "hr1234" },
    { "key": "sales_user",      "value": "sales_user" },
    { "key": "sales_pass",      "value": "sales1234" },
    { "key": "ingest_token",    "value": "local-ingest-secret-change-me" },
    { "key": "admin_token",     "value": "" },
    { "key": "finance_token",   "value": "" },
    { "key": "hr_token",        "value": "" },
    { "key": "sales_token",     "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/", "host": ["{{base_url}}"], "path": [""] }
          }
        },
        {
          "name": "FastAPI Live",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/health/live", "host": ["{{base_url}}"], "path": ["api","v1","health","live"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
          ]}}]
        },
        {
          "name": "FastAPI Ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/health/ready", "host": ["{{base_url}}"], "path": ["api","v1","health","ready"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('database is ready', function () {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().database).to.eql('ok');",
            "});"
          ]}}]
        },
        {
          "name": "Windmill UI Reachable",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{windmill_url}}", "host": ["{{windmill_url}}"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Windmill responds', function () { pm.response.to.have.status(200); });"
          ]}}]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Custom User (finance role)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"new_finance_user\",\n  \"password\": \"StrongPass123\",\n  \"role\": \"finance\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/register", "host": ["{{base_url}}"], "path": ["api","v1","auth","register"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('registered or already exists', function () { pm.expect([201, 409]).to.include(pm.response.code); });"
          ]}}]
        },
        {
          "name": "Login - admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{admin_user}}\",\n  \"password\": \"{{admin_pass}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api","v1","auth","login"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('login succeeds', function () { pm.response.to.have.status(200); });",
            "pm.collectionVariables.set('admin_token', pm.response.json().access_token);"
          ]}}]
        },
        {
          "name": "Login - finance_user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{finance_user}}\",\n  \"password\": \"{{finance_pass}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api","v1","auth","login"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('login succeeds', function () { pm.response.to.have.status(200); });",
            "pm.collectionVariables.set('finance_token', pm.response.json().access_token);"
          ]}}]
        },
        {
          "name": "Login - hr_user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{hr_user}}\",\n  \"password\": \"{{hr_pass}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api","v1","auth","login"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('login succeeds', function () { pm.response.to.have.status(200); });",
            "pm.collectionVariables.set('hr_token', pm.response.json().access_token);"
          ]}}]
        },
        {
          "name": "Login - sales_user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{sales_user}}\",\n  \"password\": \"{{sales_pass}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api","v1","auth","login"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('login succeeds', function () { pm.response.to.have.status(200); });",
            "pm.collectionVariables.set('sales_token', pm.response.json().access_token);"
          ]}}]
        },
        {
          "name": "Login - bad password (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{admin_user}}\",\n  \"password\": \"wrongpass\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api","v1","auth","login"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('unauthorized', function () { pm.response.to.have.status(401); });"
          ]}}]
        }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Upload CSV as admin (triggers Windmill)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "{{upload_file_path}}" }] },
            "url": { "raw": "{{base_url}}/api/v1/uploads/loan", "host": ["{{base_url}}"], "path": ["api","v1","uploads","loan"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('upload accepted', function () { pm.expect([201, 502]).to.include(pm.response.code); });",
            "if (pm.response.code === 201) {",
            "  const body = pm.response.json();",
            "  pm.expect(body.status).to.eql('workflow_triggered');",
            "  pm.expect(body.upload_id).to.be.a('number');",
            "  pm.expect(body.windmill_job_id).to.be.a('string');",
            "}"
          ]}}]
        },
        {
          "name": "Upload CSV as finance (expect 403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{finance_token}}" }],
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "{{upload_file_path}}" }] },
            "url": { "raw": "{{base_url}}/api/v1/uploads/loan", "host": ["{{base_url}}"], "path": ["api","v1","uploads","loan"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('forbidden for non-admin', function () { pm.response.to.have.status(403); });"
          ]}}]
        },
        {
          "name": "Upload without token (expect 401)",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "{{upload_file_path}}" }] },
            "url": { "raw": "{{base_url}}/api/v1/uploads/loan", "host": ["{{base_url}}"], "path": ["api","v1","uploads","loan"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('unauthorized without token', function () { pm.response.to.have.status(401); });"
          ]}}]
        }
      ]
    },
    {
      "name": "Department Data",
      "item": [
