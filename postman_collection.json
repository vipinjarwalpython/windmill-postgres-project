          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('forbidden across departments', function () { pm.response.to.have.status(403); });"
          ]}}]
        },
        {
          "name": "GET /data/sales as hr (expect 403)",
          "request": {
            "method": "GET",
